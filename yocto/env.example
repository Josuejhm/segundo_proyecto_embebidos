# .env - Variables de entorno para docker-compose
# Copia este archivo a .env.local para usar configuración personalizada

# Docker
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# Yocto BitBake
BB_NUMBER_THREADS=8
PARALLEL_MAKE=-j8
SSTATE_DIR=/yocto/sstate
DL_DIR=/yocto/dl
TMPDIR=/yocto/build/tmp

# Máquina y Distro
MACHINE=jetson-nano-devkit
DISTRO=poky

# Optimizaciones
BB_HASHSERVE=auto
BB_HASHSERVE_UPSTREAM=

# Localización
LANG=en_US.UTF-8
LANGUAGE=en_US:en
LC_ALL=en_US.UTF-8

# Imagen Docker
IMAGE_TAG=yocto-qwen:latest
CONTAINER_NAME=yocto-qwen-builder

# Recursos (ajustar según tu hardware)
# Si tienes 32GB RAM y 16 cores
# CPU_LIMIT=16
# MEMORY_LIMIT=28G
CPU_RESERVATION=4
MEMORY_RESERVATION=16G

# Rutas (relativas al docker-compose.yml)
REPO_DIR=.
BUILD_DIR=./volumes/build
DL_DIR_HOST=./volumes/dl
SSTATE_DIR_HOST=./volumes/sstate
OUTPUT_DIR=./volumes/output

# Git (para commits automáticos)
GIT_AUTHOR_NAME=Yocto Builder
GIT_AUTHOR_EMAIL=builder@yocto.local

# Logging
LOG_LEVEL=info
# Valores: debug, info, warn, error

# Timeouts (en segundos)
BUILD_TIMEOUT=43200  # 12 horas

# Features
ENABLE_SSH=false
ENABLE_HASH_SERVE=true
ENABLE_CCACHE=false  # Cache de compilador (experimental)

# Modelos Qwen a incluir en la imagen
QWEN_MODELS=Qwen/Qwen2-0.5B-Instruct

# Post-build
COMPRESS_OUTPUT=true
CREATE_CHECKSUM=true
NOTIFY_ON_COMPLETE=false
# NOTIFY_EMAIL=tu@email.com
